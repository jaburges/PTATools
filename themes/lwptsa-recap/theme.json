{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "layout": {
   "contentSize": "760px",
   "wideSize": "1240px"
  },
  "color": {
   "defaultPalette": false,
   "defaultGradients": false,
   "palette": [
    {
     "slug": "ink",
     "name": "Ink",
     "color": "#111418"
    },
    {
     "slug": "muted",
     "name": "Muted",
     "color": "#6b7280"
    },
    {
     "slug": "line",
     "name": "Line",
     "color": "#e8e8ea"
    },
    {
     "slug": "soft",
     "name": "Soft",
     "color": "#f5f5f4"
    },
    {
     "slug": "base",
     "name": "White",
     "color": "#ffffff"
    },
    {
     "slug": "navy",
     "name": "Council navy",
     "color": "#0a2d57"
    },
    {
     "slug": "navy-soft",
     "name": "Navy tint",
     "color": "#c9d5e6"
    },
    {
     "slug": "sun",
     "name": "Sun",
     "color": "#f3c95b"
    },
    {
     "slug": "sky",
     "name": "Sky",
     "color": "#dfeaf6"
    },
    {
     "slug": "sage",
     "name": "Sage",
     "color": "#dcece2"
    },
    {
     "slug": "rose",
     "name": "Rose",
     "color": "#f5e1dc"
    },
    {
     "slug": "ai",
     "name": "AI panel",
     "color": "#eef3fa"
    }
   ]
  },
  "typography": {
   "defaultFontSizes": false,
   "fluid": true,
   "fontFamilies": [
    {
     "slug": "inter",
     "name": "Inter",
     "fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
     "fontFace": [
      {
       "fontFamily": "Inter",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
       "src": [
        "file:./assets/fonts/inter-latin-normal.woff2"
       ]
      },
      {
       "fontFamily": "Inter",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
       "src": [
        "file:./assets/fonts/inter-latin-ext-normal.woff2"
       ]
      },
      {
       "fontFamily": "Inter",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116",
       "src": [
        "file:./assets/fonts/inter-cyrillic-normal.woff2"
       ]
      },
      {
       "fontFamily": "Inter",
       "fontStyle": "normal",
       "fontWeight": "100 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB",
       "src": [
        "file:./assets/fonts/inter-vietnamese-normal.woff2"
       ]
      }
     ]
    },
    {
     "slug": "serif",
     "name": "Source Serif 4",
     "fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
     "fontFace": [
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
       "src": [
        "file:./assets/fonts/source-serif-4-latin-normal.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
       "src": [
        "file:./assets/fonts/source-serif-4-latin-ext-normal.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116",
       "src": [
        "file:./assets/fonts/source-serif-4-cyrillic-normal.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "normal",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB",
       "src": [
        "file:./assets/fonts/source-serif-4-vietnamese-normal.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
       "src": [
        "file:./assets/fonts/source-serif-4-latin-italic.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
       "src": [
        "file:./assets/fonts/source-serif-4-latin-ext-italic.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116",
       "src": [
        "file:./assets/fonts/source-serif-4-cyrillic-italic.woff2"
       ]
      },
      {
       "fontFamily": "Source Serif 4",
       "fontStyle": "italic",
       "fontWeight": "200 900",
       "fontDisplay": "swap",
       "unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB",
       "src": [
        "file:./assets/fonts/source-serif-4-vietnamese-italic.woff2"
       ]
      }
     ]
    }
   ],
   "fontSizes": [
    {
     "slug": "xs",
     "name": "XS",
     "size": "0.8125rem",
     "fluid": false
    },
    {
     "slug": "sm",
     "name": "Small",
     "size": "0.9375rem",
     "fluid": false
    },
    {
     "slug": "md",
     "name": "Medium",
     "size": "1.0625rem",
     "fluid": false
    },
    {
     "slug": "lg",
     "name": "Large",
     "size": "1.375rem",
     "fluid": {
      "min": "1.25rem",
      "max": "1.375rem"
     }
    },
    {
     "slug": "xl",
     "name": "XL",
     "size": "1.75rem",
     "fluid": {
      "min": "1.5rem",
      "max": "1.75rem"
     }
    },
    {
     "slug": "xxl",
     "name": "2XL",
     "size": "2.625rem",
     "fluid": {
      "min": "2rem",
      "max": "2.625rem"
     }
    },
    {
     "slug": "display",
     "name": "Display",
     "size": "2.875rem",
     "fluid": {
      "min": "2.125rem",
      "max": "2.875rem"
     }
    }
   ]
  },
  "spacing": {
   "defaultSpacingSizes": false,
   "units": [
    "px",
    "rem",
    "%",
    "vw"
   ],
   "spacingSizes": [
    {
     "slug": "10",
     "name": "2XS",
     "size": "0.5rem"
    },
    {
     "slug": "20",
     "name": "XS",
     "size": "0.75rem"
    },
    {
     "slug": "30",
     "name": "S",
     "size": "1rem"
    },
    {
     "slug": "40",
     "name": "M",
     "size": "1.5rem"
    },
    {
     "slug": "50",
     "name": "L",
     "size": "2.5rem"
    },
    {
     "slug": "60",
     "name": "XL",
     "size": "clamp(2.5rem, 5vw, 3.5rem)"
    }
   ]
  },
  "shadow": {
   "defaultPresets": false,
   "presets": [
    {
     "slug": "card",
     "name": "Card",
     "shadow": "0 1px 2px rgba(17,20,24,.06), 0 8px 24px rgba(17,20,24,.06)"
    }
   ]
  },
  "custom": {
   "radius": {
    "sm": "10px",
    "md": "14px",
    "lg": "18px",
    "xl": "24px",
    "pill": "999px"
   }
  }
 },
 "styles": {
  "color": {
   "background": "var(--wp--preset--color--base)",
   "text": "var(--wp--preset--color--ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--inter)",
   "fontSize": "var(--wp--preset--font-size--md)",
   "lineHeight": "1.6"
  },
  "spacing": {
   "blockGap": "1.25rem",
   "padding": {
    "left": "clamp(1rem, 4vw, 2rem)",
    "right": "clamp(1rem, 4vw, 2rem)"
   }
  },
  "elements": {
   "link": {
    "color": {
     "text": "var(--wp--preset--color--navy)"
    },
    "typography": {
     "textDecoration": "none"
    },
    ":hover": {
     "typography": {
      "textDecoration": "underline"
     }
    }
   },
   "heading": {
    "typography": {
     "fontWeight": "700",
     "lineHeight": "1.15",
     "letterSpacing": "-0.02em"
    },
    "color": {
     "text": "var(--wp--preset--color--ink)"
    }
   },
   "h1": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--display)",
     "letterSpacing": "-0.03em",
     "lineHeight": "1.07"
    }
   },
   "h2": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xl)"
    }
   },
   "h3": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--lg)"
    }
   },
   "h4": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--md)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--navy)",
     "text": "var(--wp--preset--color--base)"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontWeight": "600",
     "fontSize": "var(--wp--preset--font-size--sm)"
    },
    "spacing": {
     "padding": {
      "top": "0.6rem",
      "bottom": "0.6rem",
      "left": "1.15rem",
      "right": "1.15rem"
     }
    },
    ":hover": {
     "color": {
      "background": "#123e74"
     }
    }
   },
   "caption": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--xs)"
    },
    "color": {
     "text": "var(--wp--preset--color--muted)"
    }
   }
  },
  "blocks": {
   "core/separator": {
    "color": {
     "text": "var(--wp--preset--color--line)"
    }
   },
   "core/quote": {
    "border": {
     "left": {
      "color": "var(--wp--preset--color--sun)",
      "width": "4px"
     }
    },
    "spacing": {
     "padding": {
      "left": "1.25rem"
     }
    }
   },
   "core/navigation": {
    "typography": {
     "fontSize": "var(--wp--preset--font-size--sm)",
     "fontWeight": "500"
    }
   },
   "core/post-title": {
    "typography": {
     "letterSpacing": "-0.02em"
    }
   },
   "core/image": {
    "border": {
     "radius": "14px"
    }
   },
   "core/post-featured-image": {
    "border": {
     "radius": "14px"
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
   "name": "footer",
   "title": "Footer",
   "area": "footer"
  }
 ],
 "customTemplates": [
  {
   "name": "page-wide",
   "title": "Wide page",
   "postTypes": [
    "page"
   ]
  }
 ]
}
